Algoritmo sin_titulo
	Definir a,b,resta Como Real 
	Escribir "Ingresa tu primer numero"
	Leer a
	Escribir "Ingresa tu segundo numero"
	Leer b
	Escribir "la suma es:" , a+b
	resta = a-b
	Escribir "La resta es:" , resta
	Escribir "La multimplicacion es:", a+b
	Escribir "La división es", a/b
	Escribir "El modulo es:", a mod b
FinAlgoritmo
 