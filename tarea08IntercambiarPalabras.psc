Algoritmo IntercambiarPalabras
    Definir A, B, auxiliar Como Caracter
    
    Escribir "Ingrese la palabra A:"
    Leer A
    Escribir "Ingrese la palabra B:"
    Leer B
    
    auxiliar = A
    A = B
    B = auxiliar
    
    Escribir "Ahora A contiene: ", A
    Escribir "Ahora B contiene: ", B
FinAlgoritmo
